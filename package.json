{
  "name": "hijri",
  "version": "0.6.0",
  "description": "Gregorian to Hijri Date conversion on NodeJS",
  "main": "hijri-date.js",
  "module": "hijri-date.mjs",
  "types": "hijri-date.d.ts",
  "exports": {
    ".": {
      "import": "./hijri-date.mjs",
      "require": "./hijri-date.js",
      "types": "./hijri-date.d.ts"
    }
  },
  "scripts": {
    "test": "mocha test.js --check-leaks",
    "lint": "eslint hijri-date.js test.js",
    "lint:fix": "eslint hijri-date.js test.js --fix",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arabiaweather/hijri-date.git"
  },
  "keywords": [
    "hijri",
    "calendar",
    "date",
    "convertor",
    "conversion",
    "convert",
    "gregorian",
    "islamic",
    "arabic"
  ],
  "devDependencies": {
    "chai": "^4.3.10",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "author": "Yousef Wadi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arabiaweather/hijri-date/issues"
  },
  "homepage": "https://github.com/arabiaweather/hijri-date"
}
